      "source": [
        "# 変数の定義\n",
        "top = 10  # 上辺：10cm\n",
        "bottom = 20  # 下辺：20cm\n",
        "height = 5  # 高さ：5cm\n",
        "\n",
        "# 台形の面積を計算して変数に代入\n",
        "# 公式: (上辺 + 下辺) × 高さ ÷ 2\n",
        "area = (top + bottom) * height / 2\n",
        "\n",
        "# 計算結果を出力（数値と文字列の組み合わせ）\n",
        "print(f\"{area}cm²\")"
      ],
