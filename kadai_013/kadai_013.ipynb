      "source": [
        "#商品購入時の消費税を、関数で計算するプログラム\n",
        "def calculate_tax(price, tax_rate):\n",
        "  return int(price * (1 + tax_rate/100))\n",
        "\n",
        "result = calculate_tax(110,10)\n",
        "print(f\"税込価格は{result}円です。\")"
      ]
    }
  ]
